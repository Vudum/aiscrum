# Copy this file to .env and fill in what you need.
# Leave ANTHROPIC_API_KEY empty to run in Practice mode (scripted team, no cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Cost guardrails (USD). Prices are per million tokens - check the pricing page if you change model.
DAILY_BUDGET_USD=1.00
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.50

# Other guardrails
MAX_MESSAGE_CHARS=2500
MAX_MESSAGES_PER_MEETING=20
MAX_PROJECTS_PER_VISITOR_PER_DAY=3

# Simulation speed: real seconds that count as one working day for the AI team.
# Come back sooner and they say "still working". 0 = instant (handy for testing).
REAL_SECONDS_PER_DAY=90

# Shown when the daily budget runs out and at the end of a project
CONTACT_URL=https://lvudum.com

# stdio (default) or memory (if your host blocks starting a second process)
MCP_TRANSPORT=stdio
